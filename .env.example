# Turso / libSQL
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Outgoing mail (SMTP on port 465 uses implicit TLS)
SMTP_HOST=mail.alliedcapitalbank.com
SMTP_PORT=465
SMTP_USER=info@alliedcapitalbank.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Allied Capital Bank <info@alliedcapitalbank.com>

# Inbox that receives notifications about customer activity
ADMIN_NOTIFY_EMAIL=info@alliedcapitalbank.com

# Password given to every newly created / imported account
DEFAULT_CUSTOMER_PASSWORD=Allied2025!
